{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@agentbox/runtime": ["./src/index.ts"],
      "@agentbox/runtime/testing": ["./src/testing/index.ts"]
    }
  },
  "include": ["examples"]
}
