{
  "name": "@agentbox/knowledge-server",
  "version": "0.1.0",
  "private": true,
  "description": "AgentBox Knowledge Base server: workspace document indexing and FTS5 retrieval.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --no-warnings --test tests/*.test.cjs",
    "verify": "npm run build && node --no-warnings --test tests/*.test.cjs",
    "dev": "npm run build && node scripts/dev.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=24"
  }
}
