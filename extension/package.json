{
  "name": "agentbox-vscode",
  "displayName": "AgentBox",
  "description": "AgentBox: Codex app-server runtime with a multi-session webview chat sidebar, inline approvals, and file context.",
  "version": "0.3.0",
  "publisher": "agentbox",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onView:agentbox.chat",
    "onCommand:agentbox.openInEditor",
    "onCommand:agentbox.openChat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agentbox",
          "title": "AgentBox",
          "icon": "media/agentbox.svg"
        }
      ]
    },
    "views": {
      "agentbox": [
        {
          "type": "webview",
          "id": "agentbox.chat",
          "name": "Chat",
          "icon": "media/agentbox.svg",
          "contextualTitle": "AgentBox"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "agentbox.openInEditor",
          "when": "view == agentbox.chat",
          "group": "navigation@1"
        },
        {
          "command": "agentbox.skills",
          "when": "view == agentbox.chat",
          "group": "navigation@2"
        },
        {
          "command": "agentbox.createSkill",
          "when": "view == agentbox.chat",
          "group": "navigation@3"
        },
        {
          "command": "agentbox.syncSkills",
          "when": "view == agentbox.chat",
          "group": "navigation@4"
        }
      ]
    },
    "commands": [
      {
        "command": "agentbox.openChat",
        "title": "AgentBox: Open Chat",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.openInEditor",
        "title": "AgentBox: Open in Editor",
        "category": "AgentBox",
        "icon": "$(open-preview)"
      },
      {
        "command": "agentbox.focusSidebar",
        "title": "AgentBox: Focus Sidebar",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.skills",
        "title": "AgentBox: Skills",
        "category": "AgentBox",
        "icon": "$(symbol-event)"
      },
      {
        "command": "agentbox.createSkill",
        "title": "AgentBox: Create Skill",
        "category": "AgentBox",
        "icon": "$(add)"
      },
      {
        "command": "agentbox.openSkillsFolder",
        "title": "AgentBox: Open Skills Folder",
        "category": "AgentBox",
        "icon": "$(folder-opened)"
      },
      {
        "command": "agentbox.validateSkill",
        "title": "AgentBox: Validate Skill",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.uploadSkill",
        "title": "AgentBox: Upload Skill",
        "category": "AgentBox",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "agentbox.syncSkills",
        "title": "AgentBox: Sync Remote Skills",
        "category": "AgentBox",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agentbox.setSkillServerToken",
        "title": "AgentBox: Set Skill Server Token",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.skillSettings",
        "title": "AgentBox: Skill Settings",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.configure",
        "title": "AgentBox: Settings",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.runTurn",
        "title": "AgentBox: Run Turn",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.cancelTurn",
        "title": "AgentBox: Cancel Turn",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.showOutput",
        "title": "AgentBox: Show Output",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.setApiKey",
        "title": "AgentBox: Set API Key",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.clearApiKey",
        "title": "AgentBox: Clear API Key",
        "category": "AgentBox"
      },
      {
        "command": "agentbox.restartRuntime",
        "title": "AgentBox: Restart Runtime",
        "category": "AgentBox"
      }
    ],
    "configuration": {
      "title": "AgentBox",
      "properties": {
        "agentbox.runtime": {
          "type": "string",
          "enum": [
            "codex",
            "fake"
          ],
          "default": "codex",
          "description": "Runtime: real Codex app-server, or the fake runtime for UI testing."
        },
        "agentbox.taskProfile": {
          "type": "string",
          "enum": [
            "simple",
            "code",
            "research"
          ],
          "default": "code",
          "description": "Task budget profile: simple = static files (8 steps / 90s), code = normal coding (20 / 180s), research = multi-step (30 / 300s)."
        },
        "agentbox.loopDetection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Stop a turn when the same tool call keeps failing or tools fail consecutively."
        },
        "agentbox.loopDetection.maxRepeatedFailures": {
          "type": "number",
          "default": 2,
          "minimum": 2,
          "description": "Stop after the same tool name+args fails this many times."
        },
        "agentbox.loopDetection.maxConsecutiveFailures": {
          "type": "number",
          "default": 4,
          "minimum": 2,
          "description": "Stop after this many consecutive tool failures."
        },
        "agentbox.codex.command": {
          "type": "string",
          "default": "codex",
          "description": "Codex executable. Use an absolute path if codex is not on PATH."
        },
        "agentbox.codex.model": {
          "type": "string",
          "default": "deepseek-flash",
          "description": "Model id passed to Codex."
        },
        "agentbox.codex.provider": {
          "type": "string",
          "default": "deepseek",
          "description": "Provider id written to the isolated CODEX_HOME/config.toml."
        },
        "agentbox.codex.baseUrl": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "OpenAI-compatible provider base URL (Codex uses the Responses API)."
        },
        "agentbox.codex.apiKeyEnv": {
          "type": "string",
          "default": "DEEPSEEK_API_KEY",
          "description": "Environment variable name used as Codex env_key."
        },
        "agentbox.codex.scope": {
          "type": "string",
          "enum": [
            "internal",
            "external"
          ],
          "default": "external",
          "description": "internal = intranet model; external = user-confirmed public provider."
        },
        "agentbox.codex.home": {
          "type": "string",
          "default": "",
          "description": "Persistent CODEX_HOME. Empty = extension global storage."
        },
        "agentbox.codex.approvalPolicy": {
          "type": "string",
          "enum": [
            "untrusted",
            "on-request",
            "never"
          ],
          "default": "on-request",
          "description": "Codex thread approval policy."
        },
        "agentbox.codex.reasoningSummary": {
          "type": "string",
          "enum": [
            "auto",
            "concise",
            "detailed",
            "none"
          ],
          "default": "auto",
          "description": "Request Codex reasoning summaries. AgentBox only displays summaries, never raw reasoning."
        },
        "agentbox.codex.reasoningEffort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "default": "medium",
          "description": "Reasoning effort passed to Codex. Lower effort reduces thinking time and tokens."
        },
        "agentbox.codex.reasoningDisplay": {
          "type": "string",
          "enum": [
            "auto",
            "summary",
            "raw",
            "off"
          ],
          "default": "auto",
          "description": "Show reasoning summaries when available, otherwise raw reasoning text. Raw reasoning is displayed in the UI only and is not written to the log."
        },
        "agentbox.codex.permissions": {
          "type": "string",
          "default": ":workspace",
          "description": "Codex permission profile id."
        },
        "agentbox.codex.autoSetupSandbox": {
          "type": "boolean",
          "default": true,
          "description": "On Windows, run windowsSandbox/setupStart once when readiness is notConfigured."
        },
        "agentbox.codex.extraInstructions": {
          "type": "string",
          "default": "",
          "markdownDescription": "Additional developer instructions appended to AgentBox's built-in Codex instructions. The built-in instructions already cover Windows/PowerShell usage and file hygiene (avoid patch/helper/browser-profile files)."
        },
        "agentbox.files.denyWrite": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/.chrome-profile/**",
            "**/*.patch",
            "**/dom.txt",
            "**/preview.png",
            "**/len-test*",
            "**/patch-test*",
            "**/apply-*.py",
            "**/.tmp/**"
          ],
          "markdownDescription": "Glob patterns for paths the file policy denies when Codex requests approval. Paths visible in the approval payload are checked; commands containing browser/profile junk markers are denied, and browser-preview commands require confirmation."
        },
        "agentbox.skills.enabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Enabled local/optional skill ids. Remote required skills are always injected and cannot be disabled."
        },
        "agentbox.skills.disabled": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Local/optional skill ids to suppress. Remote required skills cannot be disabled."
        },
        "agentbox.skills.localDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Fixed local skill directory. Empty = `~/.agentbox/skills/local`. This directory must not be inside the workspace."
        },
        "agentbox.skills.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "HTTP Skill Registry base URL, e.g. `https://skills.example.internal`. Empty = no remote skills."
        },
        "agentbox.skills.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "Sync approved/required remote skills when the extension activates."
        },
        "agentbox.skills.requiredMissing": {
          "type": "string",
          "enum": [
            "warn",
            "block"
          ],
          "default": "warn",
          "markdownDescription": "Behavior when the remote skill cache has not been synced: warn and continue, or block turn startup."
        },
        "agentbox.envFile": {
          "type": "string",
          "default": "",
          "description": "Optional .env file for local testing. ${workspaceFolder} is expanded. Prefer Set API Key / SecretStorage."
        },
        "agentbox.limits.turnTimeoutMs": {
          "type": "number",
          "minimum": 1,
          "description": "Optional per-turn timeout override. Leave empty to use the selected task profile."
        }
      }
    }
  },
  "scripts": {
    "build:runtime": "npm --prefix ../agent-runtime run build",
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run build:runtime && npm run typecheck && node esbuild.mjs",
    "test": "vitest run",
    "verify": "npm run build && npm test",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository -o agentbox-0.3.0.vsix"
  },
  "dependencies": {
    "@agentbox/runtime": "file:../agent-runtime",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
