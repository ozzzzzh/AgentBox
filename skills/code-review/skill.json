{
  "schemaVersion": 1,
  "id": "code-review",
  "name": "代码评审",
  "version": "1.0.0",
  "description": "按正确性、错误路径、并发与安全等维度评审代码变更，产出带触发条件和严重级别的 finding。",
  "owner": "general",
  "activation": "on-demand",
  "appliesTo": {
    "languages": ["typescript", "javascript", "python", "java", "go", "rust", "csharp", "php", "ruby"]
  },
  "triggers": {
    "keywords": ["code review", "review", "pull request", "pr", "diff", "评审"]
  },
  "priority": 70,
  "budget": { "maxChars": 6000 },
  "required": false
}
